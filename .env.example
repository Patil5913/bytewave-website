# ---------------------------------------------------------------------------
# Copy to .env and fill in. Only DATABASE_URI and PAYLOAD_SECRET are required;
# everything else degrades gracefully (see notes) but should be set in prod.
# ---------------------------------------------------------------------------

# Required — Postgres connection. Matches docker-compose (bwave-postgres).
DATABASE_URI=postgres://bwave:bwave@localhost:5432/bwave

# Required — signs Payload auth tokens. Generate: openssl rand -hex 32
PAYLOAD_SECRET=

# Public origin, no trailing slash. Used for Payload URLs and for absolute
# canonical / Open Graph URLs (metadataBase, sitemap.xml, robots.txt).
# Defaults to http://localhost:3000 in dev.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# --- Admin access -----------------------------------------------------------
# Email domain treated as staff for admin sign-up. Defaults to findandhire.co.
ADMIN_EMAIL_DOMAIN=findandhire.co

# --- Outbound email (SMTP) --------------------------------------------------
# If SMTP_HOST is unset, Payload falls back to its console/ethereal transport
# and lead notifications are only logged, never delivered.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Bare address only — the "find & hire" display name is set in code.
SMTP_FROM=no-reply@findandhire.dev

# Where new contact/lead submissions are emailed. Unset = notifications off.
LEADS_NOTIFY_EMAIL=

# --- Third-party ------------------------------------------------------------
# logo.dev publishable token for company logo images. Unset = logos 404.
NEXT_PUBLIC_LOGO_DEV_KEY=

# --- Preview ----------------------------------------------------------------
# Optional. Lets someone open /preview/enter?secret=… without a CMS session,
# for sharing a draft link. Editors signed into the admin do not need it.
# Generate: openssl rand -hex 32
PREVIEW_SECRET=

# --- Seeding ----------------------------------------------------------------
# Shared secret for POST /seed-content, sent as the x-seed-secret header (see
# `bun run seed`). There is no default: leave this blank and the endpoint is
# closed. It also refuses to run when NODE_ENV=production.
SEED_SECRET=
